(define (problem p-channel)
  (:domain channel)
  (:objects
    nroot nc1s nc2s nc3s ncommit - node
    c1 c2 c3 - channel
  )
  (:init
    (at nroot)
    (commit-node ncommit)
    (trans-signal-c1 nroot nc1s)
    (writes-k-channel nroot nc1s c1)
    (trans-signal-c2 nroot nc2s)
    (writes-k-channel nroot nc2s c2)
    (trans-signal-c3 nroot nc3s)
    (writes-k-channel nroot nc3s c3)
    (trans-noise-c2 nc1s ncommit)
    (writes-knot-channel nc1s ncommit c2)
    (trans-noise-c3 nc1s ncommit)
    (writes-knot-channel nc1s ncommit c3)
    (trans-noise-c1 nc2s ncommit)
    (writes-knot-channel nc2s ncommit c1)
    (trans-noise-c3 nc2s ncommit)
    (writes-knot-channel nc2s ncommit c3)
    (trans-noise-c1 nc3s ncommit)
    (writes-knot-channel nc3s ncommit c1)
    (trans-noise-c2 nc3s ncommit)
    (writes-knot-channel nc3s ncommit c2)
    (trans-signal-c2 nc1s nroot)
    (no-write nc1s nroot)
    (trans-signal-c3 nc1s nroot)
    (no-write nc1s nroot)
    (trans-signal-c1 nc2s nroot)
    (no-write nc2s nroot)
    (trans-signal-c3 nc2s nroot)
    (no-write nc2s nroot)
    (trans-signal-c1 nc3s nroot)
    (no-write nc3s nroot)
    (trans-signal-c2 nc3s nroot)
    (no-write nc3s nroot)
  )
  (:goal (and (done)))
)
