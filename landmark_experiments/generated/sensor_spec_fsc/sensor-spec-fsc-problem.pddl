(define (problem p-sensor-spec-fsc)
  (:domain sensor-spec-fsc)
  (:objects
    nroot na-ok na-faulty nb-start nb-ok nb-faulty ncommit - node
    a-ok a-faulty - sensor-a
    b-ok b-faulty - sensor-b
  )
  (:init
    (at nroot)
    (commit-node ncommit)
    (trans-a-agree nroot na-ok)
    (writes-k-sensor-a nroot na-ok a-ok)
    (trans-a-disagree nroot na-faulty)
    (writes-k-sensor-a nroot na-faulty a-faulty)
    (trans-a-agree na-ok nb-start)
    (writes-knot-sensor-a na-ok nb-start a-faulty)
    (trans-a-disagree na-faulty nb-start)
    (writes-knot-sensor-a na-faulty nb-start a-ok)
    (trans-a-disagree na-ok nroot)
    (no-write na-ok nroot)
    (trans-a-agree na-faulty nroot)
    (no-write na-faulty nroot)
    (trans-b-agree nb-start nb-ok)
    (writes-k-sensor-b nb-start nb-ok b-ok)
    (trans-b-disagree nb-start nb-faulty)
    (writes-k-sensor-b nb-start nb-faulty b-faulty)
    (trans-b-agree nb-ok ncommit)
    (writes-knot-sensor-b nb-ok ncommit b-faulty)
    (trans-b-disagree nb-faulty ncommit)
    (writes-knot-sensor-b nb-faulty ncommit b-ok)
    (trans-b-disagree nb-ok nb-start)
    (no-write nb-ok nb-start)
    (trans-b-agree nb-faulty nb-start)
    (no-write nb-faulty nb-start)
  )
  (:goal (and (done)))
)
